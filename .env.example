# =============================================================================
# FRONTEND environment  —  copy to `.env` and fill in
# =============================================================================
#
#   ⚠  EVERYTHING IN THIS FILE IS PUBLIC.
#
# Vite compiles any variable prefixed `VITE_` directly into the JavaScript
# bundle. Anyone who opens DevTools on your site can read these values. That is
# fine for the two below — it is catastrophic for a service-role key.
#
# The rule:  VITE_ prefix  =  shipped to the browser
#            no prefix     =  never reaches the browser (see backend/.env)
#
# Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, GROQ_API_KEY,
# GOOGLE_CLIENT_SECRET, VAPID_PRIVATE_KEY) belong in `backend/.env`.
# Never add them here, and never give them a VITE_ prefix.
#
# These must be set AT BUILD TIME, not just at runtime — they are baked into
# the bundle by `npm run build`. On a host like Hostinger that means setting
# them in the host's environment panel, not only in a file on the server.
# =============================================================================

# Supabase project URL. Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The ANON / public key. Dashboard → Settings → API → Project API keys → anon
# This one is DESIGNED to be public. What protects your data is Row Level
# Security (supabase/migrations/0002_rls_core.sql), not this key being secret.
#
# Do NOT paste the service_role key here. It bypasses every security policy.
VITE_SUPABASE_ANON_KEY=

# Shared password for the "Explore as Demo User" button on the login screen.
# Public by definition — it ends up in the bundle. Use a throwaway account
# that holds no real data.
VITE_DEMO_PASSWORD=

# Web push public key (Stage 6 only — leave blank until you build push).
# Generate the pair with:  npx web-push generate-vapid-keys
# The PUBLIC half goes here; the PRIVATE half goes in backend/.env.
VITE_VAPID_PUBLIC_KEY=
