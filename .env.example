# ── AI / Groq ──────────────────────────────────────────────────────────────
# Required for Groq AI API calls.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_PRIMARY_MODEL="compound-beta"
GROQ_FAST_MODEL="compound-beta-mini"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"
GROQ_MODERATION_MODEL="meta-llama/llama-prompt-guard-2-22m"


# ── App URL ───────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for OAuth callbacks and self-links).
APP_URL="MY_APP_URL"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# ── Session ───────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="MY_SESSION_SECRET"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY"
# Optional: only needed if running the one-time migration script
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
