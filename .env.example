# ── AI / OpenRouter ──────────────────────────────────────────────────────────
# Required for OpenRouter AI API calls.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# OPENROUTER_MODEL="z-ai/glm-4.5-air:free"
MODEL_MAIN="meta-llama/llama-3.3-70b-instruct:free"
MODEL_FAST="google/gemma-3-27b-it:free"
MODEL_PLANNER="deepseek/deepseek-r1:free"
MODEL_CODER="qwen/qwen3-coder:free"


# ── App URL ───────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for OAuth callbacks and self-links).
APP_URL="MY_APP_URL"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# ── Session ───────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="MY_SESSION_SECRET"

# ── MySQL (Hostinger) ─────────────────────────────────────────────────────────
DB_HOST="your_hostinger_host"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_NAME="your_db_name"
DB_PORT=3306
