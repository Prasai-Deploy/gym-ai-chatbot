# =============================================================================
# BACKEND environment  —  copy to `backend/.env` and fill in
# =============================================================================
#
#   ⚠  NOTHING IN THIS FILE MAY EVER REACH THE BROWSER.
#
# No variable here should ever be given a `VITE_` prefix or referenced from
# anything under `src/`. If a value from this file appears in your built
# JavaScript, treat it as compromised and rotate it immediately.
# =============================================================================

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key. Use this for normal requests, together with the caller's JWT,
# so Row Level Security still applies as a second line of defence.
SUPABASE_ANON_KEY=

# ⚠  THE MOST DANGEROUS VALUE IN THIS PROJECT.
# Bypasses every RLS policy — full read/write on every gym's data.
# Use it ONLY for operations that genuinely need it: running migrations,
# validating a scanned QR code before writing a check-in, claiming an
# invitation, and sending push broadcasts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Direct database connection ──────────────────────────────────────────────
# Contains your database password in cleartext. Needed only for migrations and
# admin scripts run from your own machine — never by the running app.
# Leave blank in production.
DATABASE_URL=

# ── AI ──────────────────────────────────────────────────────────────────────
# Billable. Server-side only.
GROQ_API_KEY=

# ── Google OAuth ────────────────────────────────────────────────────────────
# NOTE: with Supabase Auth you normally paste these into the Supabase
# dashboard (Authentication → Providers → Google) rather than here, and
# Supabase handles the callback. Keep these blank unless you have a specific
# reason to run the OAuth exchange yourself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web push (Stage 6 only) ─────────────────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
# The PRIVATE half goes here. The public half goes in the root .env as
# VITE_VAPID_PUBLIC_KEY. The names are nearly identical — check twice.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
